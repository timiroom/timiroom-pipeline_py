# ── OpenAI 생성 모델 ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=120
PHASE2_LLM_MAX_CONCURRENCY=8
PHASE2_TIMEOUT_SECONDS=900
PHASE3_REPAIR_TIMEOUT_SECONDS=300
PHASE2_WEB_SEARCH_ENABLED=true

# ── Upstage Solar 임베딩 ─────────────────────────────────────────
UPSTAGE_API_KEY=up_...
SOLAR_EMBEDDING_QUERY_MODEL=solar-embedding-2-query
SOLAR_EMBEDDING_PASSAGE_MODEL=solar-embedding-2-passage

# ── Cohere Rerank ────────────────────────────────────────────────
COHERE_API_KEY=...
COHERE_RERANK_MODEL=rerank-v4.0-pro
COHERE_BASE_URL=https://api.cohere.com
COHERE_MAX_CONCURRENCY=5

# ── PostgreSQL ────────────────────────────────────────────────────
DB_URL=postgresql://user:password@localhost:5432/timiroom
# NAS에서는 기존 Spring vector(1024) 테이블과 분리해서 사용
RAG_DOCUMENT_TABLE=document_chunks_ko

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PIPELINE_RESULT=rag.pipeline.result
KAFKA_TOPIC_DEAD_LETTER=rag.pipeline.result.DLT
KAFKA_CONSUMER_GROUP_ID=rag-pipeline-group
KAFKA_PUBLISH_MAX_RETRY=3
KAFKA_MAX_POLL_INTERVAL_MS=900000


# ── RAG 설정 ─────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K_VECTOR=20
RAG_TOP_K_KEYWORD=20
RAG_TOP_K_FINAL=5
RAG_RERANKER_ENABLED=true
EMBEDDING_MAX_CONCURRENCY=8
EMBEDDING_BATCH_SIZE=64
RAG_DB_MAX_CONCURRENCY=10

# ── Agent 타임아웃 (초) ───────────────────────────────────────────
AGENT_STREAM_TIMEOUT=90
AGENT_SYNC_TIMEOUT=60

# ── 검증 설정 ────────────────────────────────────────────────────
VALIDATION_MAX_RETRY=3

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
