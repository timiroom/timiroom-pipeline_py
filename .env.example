# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# ── K-EXAONE (Friendli.ai) ────────────────────────────────────────
EXAONE_API_KEY=flp_...
EXAONE_ENDPOINT_ID=(endpoint-id)

# ── PostgreSQL ────────────────────────────────────────────────────
DB_URL=postgresql://user:password@localhost:5432/timiroom

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PIPELINE_RESULT=rag.pipeline.result
KAFKA_TOPIC_DEAD_LETTER=rag.pipeline.result.DLT
KAFKA_CONSUMER_GROUP_ID=rag-pipeline-group

# ── Cohere (optional) ─────────────────────────────────────────────
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── RAG 설정 ─────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K_VECTOR=20
RAG_TOP_K_KEYWORD=20
RAG_TOP_K_FINAL=5
RAG_RERANKER_ENABLED=true

# ── Agent 타임아웃 (초) ───────────────────────────────────────────
AGENT_STREAM_TIMEOUT=90
AGENT_SYNC_TIMEOUT=60

# ── 검증 설정 ────────────────────────────────────────────────────
VALIDATION_MAX_RETRY=3

# ── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
